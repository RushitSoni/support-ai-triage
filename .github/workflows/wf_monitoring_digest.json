    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nif (rows.length === 0) {\n  return [\n    {\n      json: {\n        digest_text: 'No ticket activity in the tracked period yet.'\n      }\n    }\n  ];\n}\n\nconst lines = rows.map(\n  r =>\n    `${r.day.split('T')[0]} | Total: ${r.total_tickets} | Auto-resolved: ${r.auto_resolved} | Escalated: ${r.escalated} | Avg confidence: ${r.avg_confidence} | Misclassified: ${r.misclassifications}`\n);\n\nconst digestText = `Support AI Triage — Daily Digest\\n\\n${lines.join('\\n')}`;\n\nreturn [\n  {\n    json: {\n      digest_text: digestText\n    }\n  }\n];"
      },
